---
layout: base.njk
---
<div class="shell">
  {% include "nav.njk" %}
  {% include "topbar.njk" %}
  <main class="book" id="content">
    <article>
      <p class="eyebrow">{% if kind == "preface" %}Preface{% elif kind == "bridge" %}Maskin{% else %}Chapter {{ order | pad2 }}{% endif %}</p>
      <h1 class="chapter-title">{{ title }}.</h1>
      {% if deck %}<p class="deck">{{ deck }}</p>{% endif %}
      {{ content | safe }}
    </article>
    {% include "footer.njk" %}
  </main>
</div>
