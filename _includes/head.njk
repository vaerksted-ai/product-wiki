<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }} — {{ site.titleSuffix }}</title>
<meta name="description" content="{{ description or deck or 'A product playbook for a world where building got cheap. Written by Sebastian Kirkegaard.' }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta name="robots" content="{{ robots or 'index,follow' }}">
<meta property="og:type" content="{{ ogType or 'article' }}">
<meta property="og:title" content="{{ title }}">
<meta property="og:description" content="{{ description or deck or 'A product playbook for a world where building got cheap.' }}">
<meta property="og:url" content="{{ site.url }}{{ page.url }}">
<meta property="og:image" content="{{ site.url }}{{ site.ogImage }}">
<meta name="twitter:card" content="summary_large_image">
<link rel="icon" href="/favicon.ico">
<link rel="stylesheet" href="/styles.css">
